{
  "name": "sdkspace-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/index.js && node --check src/firebase-worker.js && node --check src/public-resources.js",
    "dev": "npm run build && wrangler dev",
    "deploy": "wrangler deploy",
    "build": "npm --prefix sites/dst ci && node scripts/build-site.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:dst": "npm --prefix sites/dst test"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
